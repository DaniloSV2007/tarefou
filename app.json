{
  "name": "Tarefou!",
  "slug": "checklistapp",
  "version": "1.0.27",
  "scheme": "tarefou",
  "icon": "./assets/adaptive-icon.png",
  "orientation": "portrait",
  "userInterfaceStyle": "automatic",
  "notification": {
    "icon": "./assets/adaptive-icon-monochrome.png",
    "color": "#337efc"
  },
  "web": {
    "bundler": "metro"
  },
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.placeholder.appid"
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "monochromeImage": "./assets/adaptive-icon-monochrome.png",
      "backgroundColor": "#ffffff"
    },
    "edgeToEdgeEnabled": true,
    "package": "com.danilosv07.tarefou",
    "usesCleartextTraffic": true
  },
  "extra": {
    "eas": {
      "projectId": "01ceaca2-f8cc-4c37-ace3-6cdcd37403b8"
    },
    "router": {}
  },
  "plugins": [
    "expo-router",
    [
      "expo-splash-screen",
      {
        "image": "./assets/splash-icon-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/splash-icon-dark.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      }
    ],
    "expo-localization",
    "expo-sqlite",
    "expo-quick-actions",
    {
      "androidIcons": {
        "new-task": {
          "monochromeImage": "./assets/adaptive-icon-monochrome.png",
          "backgroundColor": "#337efc"
        }
      }
    }
  ],
  "androidNavigationBar": {
    "backgroundColor": "#00000000"
  },
  "sdkVersion": "53.0.0",
  "platforms": ["ios", "android"],
  "runtimeVersion": {
    "policy": "appVersion"
  },
  "updates": {
    "url": "https://u.expo.dev/01ceaca2-f8cc-4c37-ace3-6cdcd37403b8",
    "checkAutomatically": "ON_ERROR_RECOVERY"
  }
}
