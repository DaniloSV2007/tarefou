{
  "cli": {
    "version": ">= 16.6.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "autoIncrement": true,
        "buildType": "apk"
      },
      "channel": "development",
      "env": {
        "GOOGLE_SERVICES": "GOOGLE_SERVICES"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "autoIncrement": true,
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "GOOGLE_SERVICES": "GOOGLE_SERVICES"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "channel": "production",
      "env": {
        "GOOGLE_SERVICES": "GOOGLE_SERVICES"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
