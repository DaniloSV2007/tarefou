{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./src/types/"
    ]
  },
  "include": [
    "./src/types/**/*.d.ts",
    "./src/**/*",
    "nativewind-env.d.ts"
  ]
}